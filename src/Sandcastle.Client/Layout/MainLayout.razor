@inherits LayoutComponentBase
@using Sandcastle.Client.Services
@using Sandcastle.Client.Components
@inject AdminState Admin
@inject SandcastleApiClient Api
@inject ThemeService Theme
@inject PaletteService Palette
@inject AttentionInboxState Inbox
@inject DialogService Dialogs
@inject ChatNotificationsService ChatNotify
@inject LocalizationService L
@inject AuthStateService Auth
@inject IJSRuntime JS
@implements IDisposable

<a class="skip-link" href="#main-content">@L["common.skip_to_content"]</a>
<div class="shell @(_focusMode ? "focus-mode" : "")">
    @if (_mobileMenu)
    {
        <div class="sb-scrim" aria-hidden="true" @onclick="CloseMobile"></div>
    }
    <aside class="sidebar @(_collapsed ? "collapsed" : "") @(_mobileMenu ? "mobile-open" : "")"
           role="@(_mobileMenu ? "dialog" : null)"
           aria-modal="@(_mobileMenu ? "true" : null)"
           @onkeydown="OnSidebarKeyDown">
        <div class="sb-head">
            <button class="icon-btn" @onclick="ToggleSidebar"
                    aria-label="@L[_collapsed ? "rail.expand" : "rail.collapse"]"
                    title="@L[_collapsed ? "rail.expand" : "rail.collapse"]"
                    aria-expanded="@(!_collapsed)">
                <Icon Name="menu" Size="16" />
            </button>
            <span class="logo">Sandcastle</span>
            <span class="grow"></span>
            @* SPEC-118: bell dropdown também no desktop (parity OWUIC) *@
            <AttentionFeed />
            <AttentionBadge Active="_attentionOnly"
                            OnClick="ToggleAttentionFilter" />
        </div>
        @if (!_collapsed)
        {
            <div class="sb-filter">
                <input placeholder="@L["sidebar.filter"]" @bind="_filter"
                       @bind:event="oninput" aria-label="@L["sidebar.filter_aria"]" />
            </div>
        }
        <div class="sb-section">
            <div class="sb-label">@L["sidebar.conversations"]</div>
            <a class="sb-item @(IsActive("/") ? "active" : "")" href="/"
               title="@L["sidebar.conversations"]">
                <Icon Name="chat" Size="16" />
                <span class="txt">@L["sidebar.conversations"]</span>
            </a>
            <a class="sb-item" href="/" title="@L["sidebar.new_chat"]">
                <Icon Name="plus" Size="16" />
                <span class="txt">@L["sidebar.new_chat"]</span>
            </a>
            @foreach (var c in FilteredConvs())
            {
                @* SPEC-118: item com menu ⋯ (copy link / delete) no hover —
                   padrão OWUIC. Fecha ao clicar fora (_menuFor scrim). *@
                <div class="sb-item-wrap">
                    <a class="sb-item @(IsActive($"/conversations/{c.Id}") ? "active" : "")"
                       href="/conversations/@c.Id" title="@(c.Title ?? c.Id)">
                        <span class="dot @DotFor(c)"></span>
                        @if (_collapsed)
                        {
                            <Icon Name="chat" Size="16" />
                        }
                        <span class="txt">@(c.Title ?? c.SelectedRepository ?? c.Id[..8])</span>
                        @if (!_collapsed && c.CostUsd is > 0)
                        {
                            <span class="conv-cost">@FormatCost(c.CostUsd.Value)</span>
                        }
                    </a>
                    @if (!_collapsed)
                    {
                        <button class="icon-btn sb-menu-btn"
                                @onclick="() => ToggleConvMenu(c.Id)"
                                @onclick:stopPropagation="true"
                                aria-label="@L["sidebar.conv_menu"]"
                                aria-expanded="@(_menuFor == c.Id)">
                            <Icon Name="dots" Size="14" />
                        </button>
                        @if (_menuFor == c.Id)
                        {
                            <div class="sb-menu-scrim" @onclick="() => _menuFor = null"></div>
                            <div class="menu sb-menu" role="menu">
                                <button class="menu-item" role="menuitem"
                                        @onclick="() => CopyConvLinkAsync(c.Id)">
                                    <Icon Name="copy" Size="13" /> @L["sidebar.copy_link"]
                                </button>
                                <button class="menu-item" role="menuitem"
                                        @onclick="() => ForkConvAsync(c.Id)">
                                    <Icon Name="fork" Size="13" /> @L["conv.fork"]
                                </button>
                                <button class="menu-item danger" role="menuitem"
                                        @onclick="() => DeleteConvAsync(c.Id)">
                                    <Icon Name="trash" Size="13" /> @L["sidebar.delete"]
                                </button>
                            </div>
                        }
                    }
                </div>
            }
            @* SPEC-136 RF-001: rotas órfãs ganham entrada na shell —
               Knowledge (/knowledge) e Customize (/customize) + Knowledge (/knowledge).. *@
            <div class="sb-label">@L["sidebar.workspace"]</div>
            @* SPEC-156 RF-001: hub unificado knowledge/skills/mcps. *@
            <a class="sb-item @(IsActive("/customize") || IsActive("/settings/skills") || IsActive("/settings/mcp") ? "active" : "")"
               href="/customize" title="@L["sidebar.customize"]">
                <Icon Name="sparkles" Size="16" />
                <span class="txt">@L["sidebar.customize"]</span>
            </a>
            @* SPEC-157 RF-003: workspace items (prompts/presets/context). *@
            <a class="sb-item @(IsActive("/projects") ? "active" : "")"
               href="/projects" title="@L["sidebar.projects"]">
                <Icon Name="folder" Size="16" />
                <span class="txt">@L["sidebar.projects"]</span>
            </a>
            <a class="sb-item @(IsActive("/workspace") ? "active" : "")"
               href="/workspace" title="@L["sidebar.workspace_items"]">
                <Icon Name="box" Size="16" />
                <span class="txt">@L["sidebar.workspace_items"]</span>
            </a>
            <a class="sb-item @(IsActive("/channels") ? "active" : "")"
               href="/channels" title="@L["sidebar.channels"]">
                <Icon Name="chat" Size="16" />
                <span class="txt">@L["sidebar.channels"]</span>
            </a>
            <a class="sb-item @(IsActive("/notes") ? "active" : "")"
               href="/notes" title="@L["sidebar.notes"]">
                <Icon Name="file" Size="16" />
                <span class="txt">@L["sidebar.notes"]</span>
            </a>
            <a class="sb-item @(IsActive("/calendar") ? "active" : "")"
               href="/calendar" title="@L["sidebar.calendar"]">
                <Icon Name="clock" Size="16" />
                <span class="txt">@L["sidebar.calendar"]</span>
            </a>
            <a class="sb-item @(IsActive("/notifications") ? "active" : "")"
               href="/notifications" title="@L["sidebar.notifications"]">
                <Icon Name="alert" Size="16" />
                <span class="txt">@L["sidebar.notifications"]</span>
            </a>
            <a class="sb-item @(IsActive("/knowledge") ? "active" : "")"
               href="/knowledge" title="@L["sidebar.knowledge"]">
                <Icon Name="book" Size="16" />
                <span class="txt">@L["sidebar.knowledge"]</span>
            </a>
            @* SPEC-145 RF-003: wiki gerada por repo (sidebar workspace). *@
            <a class="sb-item @(IsActive("/wiki") ? "active" : "")"
               href="/wiki" title="@L["sidebar.wiki"]">
                <Icon Name="file" Size="16" />
                <span class="txt">@L["sidebar.wiki"]</span>
            </a>
            @* SPEC-143 RF-005: code scans — findings triáveis + fix. *@
            <a class="sb-item @(IsActive("/scans") ? "active" : "")"
               href="/scans" title="@L["sidebar.scans"]">
                <Icon Name="search" Size="16" />
                <span class="txt">@L["sidebar.scans"]</span>
            </a>
            @* SPEC-144 RF-005: batch refactors — lotes com PR próprio. *@
            <a class="sb-item @(IsActive("/refactors") ? "active" : "")"
               href="/refactors" title="@L["sidebar.refactors"]">
                <Icon Name="git-branch" Size="16" />
                <span class="txt">@L["sidebar.refactors"]</span>
            </a>
            @* #435: PR reviews — findings triáveis do auto-review
               (SPEC-140 deferral). *@
            <a class="sb-item @(IsActive("/reviews") ? "active" : "")"
               href="/reviews" title="@L["sidebar.reviews"]">
                <Icon Name="git-pull-request" Size="16" />
                <span class="txt">@L["sidebar.reviews"]</span>
            </a>
            @* SPEC-151 RF-004: alert integrations — sources + events. *@
            <a class="sb-item @(IsActive("/alerts") ? "active" : "")"
               href="/alerts" title="@L["sidebar.alerts"]">
                <Icon Name="alert" Size="16" />
                <span class="txt">@L["sidebar.alerts"]</span>
            </a>
            <div class="sb-label">@L["sidebar.general"]</div>
            <a class="sb-item @(IsActive("/automations") ? "active" : "")"
               href="/automations" title="@L["sidebar.automations"]">
                <Icon Name="clock" Size="16" />
                <span class="txt">@L["sidebar.automations"]</span>
                @if (_summary?.AutomationCount > 0)
                {
                    <span class="badge-n">@_summary.AutomationCount</span>
                }
            </a>
            @* SPEC-148 RF-004: marketplace — catálogo instalável de
               skills/agents/mcp/hooks (browse + installed). *@
            <a class="sb-item @(IsActive("/marketplace") ? "active" : "")"
               href="/marketplace" title="@L["sidebar.marketplace"]">
                <Icon Name="package" Size="16" />
                <span class="txt">@L["sidebar.marketplace"]</span>
            </a>
            @* SPEC-179 RF-003: rotas de produto da cloud shell. *@
            <a class="sb-item @(IsActive("/extensions") ? "active" : "")"
               href="/extensions" title="@L["sidebar.extensions"]">
                <Icon Name="package" Size="16" />
                <span class="txt">@L["sidebar.extensions"]</span>
                @if (_summary?.ExtensionCount > 0)
                {
                    <span class="badge-n">@_summary.ExtensionCount</span>
                }
            </a>
            <a class="sb-item @(IsActive("/factories") ? "active" : "")"
               href="/factories" title="@L["sidebar.factories"]">
                <Icon Name="git-branch" Size="16" />
                <span class="txt">@L["sidebar.factories"]</span>
                @if (_summary?.FactoryCount > 0)
                {
                    <span class="badge-n">@_summary.FactoryCount</span>
                }
            </a>
            @* SPEC-130 RF-001: engrenagem abre o SettingsModal sobre a
               conversa; /settings segue como deep-link direto. *@
            <button type="button" class="sb-item"
                    title="@L["sidebar.settings"]"
                    aria-label="@L["sidebar.settings"]"
                    @onclick="OpenSettingsAsync">
                <Icon Name="settings" Size="16" />
                <span class="txt">@L["sidebar.settings"]</span>
            </button>
            @if (_isAdmin)
            {
                <div class="sb-label">@L["sidebar.admin"]</div>
                <a class="sb-item @(IsActive("/admin") ? "active" : "")"
                   href="/admin" title="@L["sidebar.admin"]">
                    <Icon Name="shield" Size="16" />
                    <span class="txt">@L["sidebar.administration"]</span>
                </a>
            }
        </div>
        <div class="sb-foot">
            @* SPEC-132 RF-004: user menu (avatar + theme + sign-out)
               substitui o ThemeToggle solto do footer. *@
            <UserMenu />
            <span class="grow"></span>
            @if (_collapsed)
            {
                <button class="icon-btn" @onclick="ToggleSidebar"
                        aria-label="@L["rail.expand"]"
                        title="@L["rail.expand"]">
                    <Icon Name="chevron-right" Size="16" />
                </button>
            }
            <a class="icon-btn" href="https://github.com/afonsoft/sandcastle"
               target="_blank" title="@L["sidebar.repository"]" aria-label="@L["sidebar.repository"]">
                <Icon Name="code" Size="16" />
            </a>
        </div>
    </aside>
    <main class="content" id="main-content" tabindex="-1">
        @* SPEC-179 RF-001/RF-003: topbar contextual desktop com breadcrumbs,
           command center e modo foco. *@
        <div class="desktop-topbar">
            <nav class="breadcrumbs" aria-label="Breadcrumb">
                @foreach (var crumb in Breadcrumbs())
                {
                    @if (crumb.Href is null)
                    {
                        <span class="crumb current" aria-current="page">@crumb.Label</span>
                    }
                    else
                    {
                        <a class="crumb" href="@crumb.Href">@crumb.Label</a>
                        <span class="crumb-sep" aria-hidden="true">/</span>
                    }
                }
            </nav>
            <span class="grow"></span>
            @if (_summary is not null)
            {
                <span class="nav-pill" title="@L["shell.running"]">
                    <span class="dot running"></span>@_summary.RunningCount
                </span>
                <span class="nav-pill" title="@L["shell.attention"]">
                    <span class="dot waiting"></span>@_summary.AttentionCount
                </span>
            }
            <button type="button" class="cmdk-open" @onclick="OpenPaletteAsync"
                    aria-label="@L["shell.command"]" title="@L["shell.command"]">
                <Icon Name="search" Size="14" />
                <span class="kbd">Ctrl K</span>
            </button>
            <button type="button" class="icon-btn focus-toggle" @onclick="ToggleFocusModeAsync"
                    aria-label="@L[_focusMode ? "shell.exit_focus" : "shell.focus"]"
                    title="@L[_focusMode ? "shell.exit_focus" : "shell.focus"]"
                    aria-pressed="@(_focusMode ? "true" : "false")">
                <Icon Name="eye" Size="15" />
            </button>
        </div>
        <div class="mobile-topbar">
            <button class="icon-btn" @onclick="OpenMobile"
                    aria-label="@L["sidebar.toggle"]"
                    aria-expanded="@_mobileMenu">
                <Icon Name="menu" Size="16" />
            </button>
            <span class="logo">Sandcastle</span>
            <span class="grow"></span>
            <AttentionFeed />
        </div>
        <OfflineBanner />
        @Body
    </main>
</div>
@* SPEC-119: host dos diálogos in-app (confirm/prompt acessíveis) *@
<DialogHost />

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private bool _isAdmin;
    private bool _collapsed;
    private bool _mobileMenu;
    private bool _attentionOnly;
    private string? _menuFor;
    private string _filter = "";
    private IReadOnlyList<ConversationItem> _convs = [];
    private NavigationSummaryDto? _summary;
    private bool _focusMode;
    private long _navStarted;
    private string? _pendingTelemetryRoute;

    private bool _inited;

    protected override async Task OnInitializedAsync()
    {
        // SPEC-132 RF-003: subscrições antes do guard — cair direto em
        // /auth ainda garante eventos de nav e o init adiado pós-login.
        Inbox.Changed += OnAttentionChanged;
        L.Changed += OnLocaleChanged;
        Nav.LocationChanged += OnNav;
        Palette.Provider = BuildPaletteAsync;
        if (!GuardCurrentRoute())
        {
            return;
        }

        await InitShellAsync();
    }

    /// <summary>Trabalho pesado só após passar no guard de auth
    /// (a página /auth não dispara tempestade de 401).</summary>
    private async Task InitShellAsync()
    {
        if (_inited)
        {
            return;
        }

        _inited = true;
        _isAdmin = await Admin.EnsureLoadedAsync();
        await Inbox.EnsureStartedAsync();
        await ChatNotify.EnsureStartedAsync();
        try
        {
            // SPEC-130 RF-004: chave sc.sidebar.collapsed; sc.sidebar
            // (SPEC-118) lida como fallback na migração.
            _collapsed = (await JS.InvokeAsync<string?>(
                    "localStorage.getItem", "sc.sidebar.collapsed")
                ?? await JS.InvokeAsync<string?>(
                    "localStorage.getItem", "sc.sidebar")) == "1";
            _convs = (await Api.ListConversationsAsync())
                .OrderByDescending(c => c.UpdatedAt).Take(20).ToList();
            _summary = await Api.GetNavigationSummaryAsync();
            _focusMode = (await JS.InvokeAsync<string?>(
                "sessionStorage.getItem", "sc.shell.focus")) == "1";
        }
        catch (Exception) { /* JS indisponível em pré-render / offline */ }
    }

    private async Task RefreshSummaryAsync()
    {
        try
        {
            var summary = await Api.GetNavigationSummaryAsync();
            if (summary is not null)
            {
                _summary = summary;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception) { /* badges são best-effort; nunca bloqueiam navegação */ }
    }

    private void OnNav(object? s, LocationChangedEventArgs e)
    {
        _mobileMenu = false;
        _menuFor = null;
        _navStarted = System.Diagnostics.Stopwatch.GetTimestamp();
        _pendingTelemetryRoute = Nav.ToBaseRelativePath(e.Location);
        if (GuardCurrentRoute() && !_inited)
        {
            _ = InitShellAsync();
        }
        else if (_inited)
        {
            _ = RefreshSummaryAsync();
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>SPEC-132: false = navegação interceptada para /auth.
    /// Rotas públicas (/auth, /share/*, /shared/*) nunca bloqueiam.</summary>
    private bool GuardCurrentRoute()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        if (Auth.RequiresAuth && !Auth.IsAuthenticated
            && !AuthStateService.IsPublicPath(relative))
        {
            Nav.NavigateTo(
                $"/auth?returnUrl={Uri.EscapeDataString("/" + relative)}");
            return false;
        }

        return true;
    }

    /// <summary>SPEC-118: menu de contexto por conversa (padrão OWUIC).</summary>
    private void ToggleConvMenu(string id) =>
        _menuFor = _menuFor == id ? null : id;

    private async Task CopyConvLinkAsync(string id)
    {
        _menuFor = null;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText",
                $"{Nav.BaseUri.TrimEnd('/')}/conversations/{id}");
        }
        catch (Exception) { /* clipboard indisponível */ }
    }

    /// <summary>SPEC-135 RF-002: fork da conversa pela sidebar —
    /// navega para a filha (boot via start-task dela).</summary>
    private async Task ForkConvAsync(string id)
    {
        _menuFor = null;
        try
        {
            var fork = await Api.ForkConversationAsync(id);
            Nav.NavigateTo($"/conversations/{fork.Id}");
        }
        catch (Exception) { /* 409 run ativa / offline */ }
    }

    private async Task DeleteConvAsync(string id)
    {
        _menuFor = null;
        // SPEC-119: dialog in-app acessível substitui window.confirm.
        if (!await Dialogs.ConfirmAsync(L["sidebar.delete_confirm"], danger: true))
        {
            return;
        }

        try
        {
            await Api.DeleteConversationAsync(id);
            _convs = _convs.Where(c => c.Id != id).ToList();
        }
        catch (Exception) { /* offline / erro de API — item permanece */ }
    }

    /// <summary>SPEC-130 RF-001: SettingsModal via DialogService —
    /// fluxo não navega para fora do chat.</summary>
    private async Task OpenSettingsAsync() =>
        await Dialogs.ShowSettingsAsync();

    private void OpenMobile() => _mobileMenu = true;

    private void CloseMobile() => _mobileMenu = false;

    private void OnSidebarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _mobileMenu = false;
        }
    }

    /// <summary>SPEC-44: ticks do inbox re-renderizam dots/badge.</summary>
    private void OnAttentionChanged() => InvokeAsync(StateHasChanged);

    /// <summary>SPEC-46: troca de idioma re-renderiza layout + @Body.</summary>
    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    /// <summary>SPEC-44 RF-003: filtro "Aguardando você".</summary>
    private void ToggleAttentionFilter() => _attentionOnly = !_attentionOnly;

    /// <summary>Itens da palette: ações fixas + conversas recentes.</summary>
    private async Task<IEnumerable<PaletteService.Item>> BuildPaletteAsync()
    {
        var items = new List<PaletteService.Item>
        {
            new("new", L["sidebar.new_chat"], "home", "plus",
                () => { Nav.NavigateTo("/"); return Task.CompletedTask; }),
            new("theme", L.T("palette.theme", ("theme", Theme.Theme)),
                "ui", "sun",
                async () => await Theme.SetAsync(Theme.Theme switch
                {
                    ThemeService.Dark => ThemeService.Light,
                    ThemeService.Light => ThemeService.System,
                    _ => ThemeService.Dark,
                })),
            new("automations", L["sidebar.automations"], "produto", "clock",
                () => { Nav.NavigateTo("/automations"); return Task.CompletedTask; }),
            new("knowledge", L["sidebar.knowledge"], "produto", "book",
                () => { Nav.NavigateTo("/knowledge"); return Task.CompletedTask; }),
            new("workspace", L["sidebar.workspace_items"], "produto", "box",
                () => { Nav.NavigateTo("/workspace"); return Task.CompletedTask; }),
            new("extensions", L["sidebar.extensions"], "produto", "package",
                () => { Nav.NavigateTo("/extensions"); return Task.CompletedTask; }),
            new("factories", L["sidebar.factories"], "produto", "git-branch",
                () => { Nav.NavigateTo("/factories"); return Task.CompletedTask; }),
            new("mcp", L["sidebar.skills_mcp"], "produto", "sparkles",
                () => { Nav.NavigateTo("/settings/mcp"); return Task.CompletedTask; }),
            new("settings", L["sidebar.settings"], "página", "settings",
                () => { Nav.NavigateTo("/settings"); return Task.CompletedTask; }),
        };
        if (_isAdmin)
        {
            items.Add(new("admin", L["sidebar.administration"], "página",
                "shield",
                () => { Nav.NavigateTo("/admin"); return Task.CompletedTask; }));
        }

        try
        {
            var convs = _convs.Count > 0 ? _convs
                : (await Api.ListConversationsAsync())
                    .OrderByDescending(c => c.UpdatedAt).Take(20).ToList();
            items.AddRange(convs.Select(c => new PaletteService.Item(
                c.Id,
                c.Title ?? c.SelectedRepository ?? L["palette.conversation"],
                c.ExecutionStatus.ToLowerInvariant(), "chat",
                () =>
                {
                    Nav.NavigateTo($"/conversations/{c.Id}");
                    return Task.CompletedTask;
                })));
        }
        catch (HttpRequestException) { /* best-effort — falha tolerada */ }
        return items;
    }

    /// <summary>SPEC-179 RF-002: abre o command center global.</summary>
    private Task OpenPaletteAsync() => Palette.OpenAsync();

    /// <summary>SPEC-179 RF-004: modo foco oculta a sidebar e amplia o painel.</summary>
    private async Task ToggleFocusModeAsync()
    {
        _focusMode = !_focusMode;
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem",
                "sc.shell.focus", _focusMode ? "1" : "0");
        }
        catch (JSException) { /* best-effort — falha tolerada */ }
    }

    /// <summary>SPEC-179 RF-003: breadcrumbs por contexto de rota.</summary>
    private IReadOnlyList<(string Label, string? Href)> Breadcrumbs()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        var parts = relative.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var crumbs = new List<(string Label, string? Href)>
        {
            (L["shell.home"], parts.Length == 0 ? null : "/"),
        };
        if (parts.Length == 0)
        {
            return crumbs;
        }

        var area = parts[0].ToLowerInvariant();
        var areaKey = area switch
        {
            "conversations" => "sidebar.conversations",
            "automations" => "sidebar.automations",
            "factories" => "sidebar.factories",
            "workspace" => "sidebar.workspace_items",
            "settings" or "customize" => "sidebar.settings",
            "extensions" => "sidebar.extensions",
            "knowledge" => "sidebar.knowledge",
            "admin" => "sidebar.administration",
            _ => "shell.area",
        };
        var areaHref = area is "settings" or "customize" ? "/settings" : "/" + area;
        crumbs.Add((areaKey == "shell.area" ? area : L[areaKey],
            parts.Length == 1 ? null : areaHref));
        if (parts.Length > 1)
        {
            crumbs.Add((L["shell.details"], null));
        }

        return crumbs;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingTelemetryRoute is not { } route)
        {
            return;
        }

        _pendingTelemetryRoute = null;
        var elapsed = _navStarted == 0 ? 0
            : (int)System.Diagnostics.Stopwatch.GetElapsedTime(_navStarted)
                .TotalMilliseconds;
        _ = Api.PostUxEventAsync("route_navigation", route, elapsed);
    }

    private async Task ToggleSidebar()
    {
        _collapsed = !_collapsed;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem",
                "sc.sidebar.collapsed", _collapsed ? "1" : "0");
        }
        catch (JSException) { /* best-effort — falha tolerada */ }
    }

    private IEnumerable<ConversationItem> FilteredConvs()
    {
        var convs = _attentionOnly
            ? _convs.Where(c => AttentionKindOf(c.Id) is not null)
            : _convs;
        return string.IsNullOrWhiteSpace(_filter)
            ? convs
            : convs.Where(c =>
                (c.Title ?? "").Contains(_filter,
                    StringComparison.OrdinalIgnoreCase)
                || (c.SelectedRepository ?? "").Contains(_filter,
                    StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Kind de attention do inbox (fonte live) para a conversa.</summary>
    private string? AttentionKindOf(string conversationId) =>
        Inbox.Items.FirstOrDefault(i =>
            i.ConversationId.Equals(conversationId,
                StringComparison.OrdinalIgnoreCase))?.Kind
        ?? (_convs.FirstOrDefault(c => c.Id == conversationId)
            ?.NeedsAttention);

    /// <summary>SPEC-44: dot por kind de attention vence o de status.</summary>
    private string DotFor(ConversationItem c) =>
        AttentionKindOf(c.Id) is { } kind
            ? $"attention attention-{kind}"
            : DotClass(c.ExecutionStatus);

    private static string FormatCost(decimal cost) =>
        cost < 0.01m ? "<$0.01" : $"${cost:0.00}";

    private static string DotClass(string status) => status.ToUpperInvariant() switch
    {
        "RUNNING" => "running",
        "WORKING" or "SETTING_UP_WORKSPACE" or "SETTING_UP_SKILLS"
            or "SETTING_UP_GIT" => "working",
        "WAITING_FOR_CONFIRMATION" => "waiting",
        "ERROR" or "STOPPED" => "error",
        _ => "idle",
    };

    private bool IsActive(string prefix) =>
        Nav.Uri.Equals(Nav.BaseUri, StringComparison.OrdinalIgnoreCase)
            ? prefix == "/"
            : prefix != "/" && Nav.Uri.StartsWith(
                new Uri(new Uri(Nav.BaseUri), prefix.TrimStart('/')).ToString(),
                StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        Nav.LocationChanged -= OnNav;
        Inbox.Changed -= OnAttentionChanged;
        L.Changed -= OnLocaleChanged;
    }
}

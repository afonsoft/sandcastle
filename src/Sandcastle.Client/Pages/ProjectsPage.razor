@page "/projects"
@using Sandcastle.Client.Services
@inject SandcastleApiClient Api
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L["projects.title"] · Sandcastle</PageTitle>

<div class="settings-wrap">
    <h1>@L["projects.title"]</h1>
    <p class="sub" style="color:var(--sc-fg-dim)">@L["projects.hint"]</p>

    <section class="panel" aria-labelledby="project-create">
        <h2 id="project-create">@L["projects.new"]</h2>
        <div class="form-grid">
            <label>@L["projects.name"]<input @bind="_name" maxlength="200" /></label>
            <label>@L["projects.repositories"]<input @bind="_repositories" placeholder="owner/repo, owner/docs" /></label>
            <label>@L["projects.description"]<textarea @bind="_description" rows="2"></textarea></label>
            <label><input type="checkbox" @bind="_startCoordinator" /> @L["projects.start_coordinator"]</label>
            <button class="btn primary" @onclick="CreateAsync" disabled="@_busy">@L["projects.create"]</button>
        </div>
        @if (_error is not null) { <p class="error">@_error</p> }
    </section>

    @if (_projects is null)
    {
        <p class="sub">@L["projects.loading"]</p>
    }
    else if (_projects.Count == 0)
    {
        <p class="sub">@L["projects.empty"]</p>
    }
    else
    {
        <table class="table">
            <thead><tr>
                <th>@L["projects.col_name"]</th>
                <th>@L["projects.col_repositories"]</th>
                <th>@L["projects.col_coordinator"]</th>
                <th>@L["projects.col_updated"]</th>
            </tr></thead>
            <tbody>
            @foreach (var p in _projects)
            {
                <tr>
                    <td><a href="/projects/@p.Id">@p.Name</a></td>
                    <td>@string.Join(", ", p.Repositories)</td>
                    <td>@(p.CoordinatorConversationId is null ? "—" : L["projects.coordinator_linked"])</td>
                    <td style="color:var(--sc-fg-dim)">@p.UpdatedAt.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<ProjectDto>? _projects;
    private string _name = "";
    private string _description = "";
    private string _repositories = "";
    private bool _startCoordinator;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync() =>
        _projects = await Api.ListProjectsAsync();

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var repos = _repositories.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            var created = await Api.CreateProjectAsync(
                _name, _description, repos, _startCoordinator);
            if (created is null)
            {
                _error = L["projects.create_failed"];
                return;
            }
            Nav.NavigateTo($"/projects/{created.Id}");
        }
        finally { _busy = false; }
    }
}

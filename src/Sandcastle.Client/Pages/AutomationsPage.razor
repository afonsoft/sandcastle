@page "/automations"
@using Sandcastle.Client.Services
@inject Sandcastle.Client.Services.SandcastleApiClient Api
@inject Sandcastle.Client.Services.LocalizationService L
@inject Sandcastle.Client.Services.ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@L["automations.title"] · Sandcastle</PageTitle>

<h1>@L["automations.title"]</h1>
<p>@L["automations.subtitle"]</p>

@* SPEC-160 RF-002: calendário vira tab dentro de /automations. *@
<div class="tab-bar" role="tablist" aria-label="@L["automations.title"]">
    <button role="tab" class="@(Current == "list" ? "active" : "")"
            aria-selected="@(Current == "list")"
            @onclick='() => Nav.NavigateTo("/automations?tab=list")'>
        @L["automations.tab_list"]
    </button>
    <button role="tab" class="@(Current == "calendar" ? "active" : "")"
            aria-selected="@(Current == "calendar")"
            @onclick='() => Nav.NavigateTo("/automations?tab=calendar")'>
        @L["automations.tab_calendar"]
    </button>
</div>

@if (Current == "calendar")
{
    <Sandcastle.Client.Components.AutomationCalendar />
}
else if (_items is null)
{
    <p><em>@L["common.loading"]</em></p>
}
else
{
    @if (_upcoming.Count > 0)
    {
        <p>@L["automations.upcoming"]</p>
        <ul>
            @foreach (var u in _upcoming)
            {
                <li><a href="/automations/@u.Id">@u.Name</a> — @u.NextRunAt?.LocalDateTime.ToString("g")</li>
            }
        </ul>
    }
    <table class="table">
        <thead>
            <tr>
                <th>@L["automations.name"]</th>
                <th>@L["automations.health"]</th>
                <th>@L["automations.schedule"]</th>
                <th>@L["automations.next_run"]</th>
                <th>@L["automations.last_run"]</th>
                <th>@L["automations.enabled"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _items)
            {
                <tr>
                    <td><a href="/automations/@a.Id">@a.Name</a></td>
                    @* SPEC-163 RF-003: dot de saúde com tooltip. *@
                    <td>
                        <span style="display:inline-block;width:0.7em;height:0.7em;border-radius:50%;background:@HealthColor(a.Health)"
                              title="@HealthLabel(a.Health)"
                              aria-label="@HealthLabel(a.Health)"></span>
                    </td>
                    <td>@ScheduleLabel(a)</td>
                    <td>@(a.NextRunAt?.LocalDateTime.ToString("g") ?? "—")</td>
                    <td>@(a.LastRunAt?.LocalDateTime.ToString("g") ?? "—")</td>
                    <td>
                        <input type="checkbox" checked="@a.Enabled"
                               aria-label="@(L["automations.enabled"])"
                               @onchange="_ => ToggleAsync(a)" />
                    </td>
                    <td>
                        <button @onclick="() => RunNowAsync(a)">
                            @L["automations.run_now"]
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Current == "list")
{
<h2>@L["automations.new"]</h2>
<div>
    <input aria-label="@L["automations.name_placeholder"]" placeholder="@L["automations.name_placeholder"]" @bind="_name" />
    <textarea aria-label="@L["automations.prompt_placeholder"]" placeholder="@L["automations.prompt_placeholder"]"
              @bind="_prompt" rows="3" style="width:100%"></textarea>
    <select @bind="_kind" aria-label="@(L["automations.schedule"])">
        <option value="interval">@L["automations.kind_interval"]</option>
        <option value="daily">@L["automations.kind_daily"]</option>
        <option value="weekly">@L["automations.kind_weekly"]</option>
        <option value="once">@L["automations.kind_once"]</option>
        @* SPEC-162: cron + timezone + approval preset. *@
        <option value="cron">@L["automations.kind_cron"]</option>
    </select>
    @if (_kind == "interval")
    {
        <input type="number" min="5" @bind="_interval"
               aria-label="@(L["automations.interval_minutes"])" />
    }
    @if (_kind is "daily" or "weekly")
    {
        <input placeholder="HH:mm" @bind="_time"
               aria-label="@(L["automations.time_utc"])" />
    }
    @if (_kind == "weekly")
    {
        <input type="number" min="0" max="6" @bind="_weekday"
               aria-label="@(L["automations.weekday"])" />
    }
    @if (_kind == "cron")
    {
        <input placeholder="0 9 * * 1-5" @bind="_cron"
               aria-label="@(L["automations.cron_expression"])" />
    }
    @if (_kind is "daily" or "weekly" or "cron")
    {
        <input placeholder="UTC" @bind="_timeZone"
               aria-label="@(L["automations.time_zone"])" />
    }
    <select @bind="_preset" aria-label="@(L["automations.approval_preset"])">
        <option value="">@L["automations.preset_default"]</option>
        <option value="allow">@L["automations.preset_allow"]</option>
        <option value="allow-readonly">@L["automations.preset_allow_readonly"]</option>
        <option value="plan">@L["automations.preset_plan"]</option>
    </select>
    <button @onclick="CreateAsync"
            disabled="@string.IsNullOrWhiteSpace(_name)">
        @L["common.create"]
    </button>
    @if (_error is not null)
    {
        <p class="text-danger">@_error</p>
    }
</div>
}

@code {
    /// <summary>SPEC-160: deep-link ?tab=list|calendar.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string Current => Tab == "calendar" ? "calendar" : "list";

    private List<AutomationItem>? _items;
    private List<AutomationItem> _upcoming = [];
    private string? _name, _prompt, _time, _error;
    private string _kind = "interval";
    private int _interval = 60, _weekday = 1;
    // SPEC-162: cron + timezone + approval preset.
    private string? _cron, _timeZone, _preset;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => await Reload();

    /// <summary>Recarrega ao voltar do tab calendar (query muda sem init).</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Current == "list" && _items is null) { await Reload(); }
    }

    private async Task Reload()
    {
        if (Current == "calendar") { return; }
        _items = (await Api.ListAutomationsAsync()).ToList();
        _upcoming = _items
            .Where(a => a.Enabled && a.NextRunAt is not null)
            .OrderBy(a => a.NextRunAt).Take(10).ToList();
    }

    // SPEC-163 RF-003: cor/label do dot de saúde.
    private static string HealthColor(string? health) => health switch
    {
        "yellow" => "#d97706",
        "red" => "#dc2626",
        _ => "#16a34a",
    };

    private string HealthLabel(string? health) => health switch
    {
        "yellow" => L["automations.health_yellow"],
        "red" => L["automations.health_red"],
        _ => L["automations.health_green"],
    };

    private string ScheduleLabel(AutomationItem a) => a.ScheduleKind switch
    {
        "interval" => L.T("automations.every_minutes",
            ("minutes", a.IntervalMinutes.ToString())),
        "daily" => $"{L["automations.kind_daily"]} {a.ScheduleTimeUtc} UTC",
        "weekly" => $"{L["automations.kind_weekly"]} {a.ScheduleTimeUtc} UTC",
        "once" => L["automations.kind_once"],
        // SPEC-162: cron rotula com expressão + fuso.
        "cron" => $"cron {a.CronExpression} ({a.TimeZoneId ?? "UTC"})",
        _ => a.ScheduleKind,
    };

    private async Task ToggleAsync(AutomationItem a)
    {
        var updated = await Api.PatchAutomationAsync(
            a.Id, new { enabled = !a.Enabled });
        if (updated is null) { Toasts.Error(L["automations.update_failed"]); }
        await Reload();
    }

    private async Task RunNowAsync(AutomationItem a)
    {
        var run = await Api.RunAutomationNowAsync(a.Id);
        if (run is null)
        {
            Toasts.Warn(L["automations.already_running"]);
        }
        else
        {
            Toasts.Success(L["automations.fired"]);
            await Reload();
        }
    }

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            var created = await Api.CreateAutomationAsync(new
            {
                name = _name, prompt = _prompt,
                schedule_kind = _kind,
                schedule_time_utc = _time,
                interval_minutes = _kind == "interval" ? _interval : (int?)null,
                weekday = _kind == "weekly" ? _weekday : (int?)null,
                // SPEC-162: cron + timezone + approval preset.
                cron_expression = _kind == "cron"
                    ? string.IsNullOrWhiteSpace(_cron) ? null : _cron : null,
                time_zone_id = string.IsNullOrWhiteSpace(_timeZone)
                    ? null : _timeZone,
                approval_preset = string.IsNullOrWhiteSpace(_preset)
                    ? null : _preset,
            });
            Nav.NavigateTo($"/automations/{created.Id}");
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }
}

@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject Sandcastle.Client.Services.LocalizationService L

@if (_loading)
{
    <p><em>@L["common.loading"]</em></p>
}
else if (_plan is null)
{
    <p class="empty-state">@L["plan_artifact.empty"]</p>
}
else
{
    <section>
        <h3>@L["plan_artifact.title"] · v@Version</h3>
        @foreach (var item in Items)
        {
            <article>
                <h4>@Str(item, "title") <span class="badge">@Str(item, "status")</span></h4>
                @if (!string.IsNullOrWhiteSpace(Str(item, "rationale")))
                {
                    <p>@Str(item, "rationale")</p>
                }
                @foreach (var file in Files(item))
                {
                    <button @onclick="() => LoadDiffAsync(file)">@file</button>
                }
                @foreach (var comment in Comments(item))
                {
                    <blockquote>@comment</blockquote>
                }
                <input aria-label="@L["plan_artifact.comment"]" placeholder="@L["plan_artifact.comment"]"
                       value="@_comments.GetValueOrDefault(Key(item))"
                       @onchange="e => _comments[Key(item)] = e.Value?.ToString()" />
                <button @onclick='() => DecideAsync(item, "approve")'>@L["plan_artifact.approve"]</button>
                <button @onclick='() => DecideAsync(item, "reject")'>@L["plan_artifact.reject"]</button>
                <button @onclick='() => DecideAsync(item, "modify")'>@L["plan_artifact.modify"]</button>
            </article>
        }
        <button class="primary" @onclick="ExecuteAsync">@L["plan_artifact.execute"]</button>
        @if (_error is not null)
        {
            <p class="text-danger">@_error</p>
        }
        @if (_diff is not null)
        {
            <pre>@_diff</pre>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public string ConversationId { get; set; } = "";

    private JsonElement? _plan;
    private bool _loading = true;
    private string? _error;
    private string? _diff;
    private readonly Dictionary<string, string?> _comments = [];

    private int Version => _plan?.GetProperty("version").GetInt32() ?? 0;
    private IEnumerable<JsonElement> Items =>
        _plan?.GetProperty("items").EnumerateArray() ?? [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await Http.GetAsync(
            $"api/v1/app-conversations/{ConversationId}/plan");
        _plan = response.IsSuccessStatusCode
            ? await response.Content.ReadFromJsonAsync<JsonElement>()
            : null;
        _loading = false;
    }

    private async Task DecideAsync(JsonElement item, string decision)
    {
        _error = null;
        var key = Key(item);
        var response = await Http.PostAsJsonAsync(
            $"api/v1/app-conversations/{ConversationId}/plan/items/{key}/decision",
            new { decision, comment = _comments.GetValueOrDefault(key) });
        if (!response.IsSuccessStatusCode)
        {
            _error = await response.Content.ReadAsStringAsync();
        }
        await LoadAsync();
    }

    private async Task ExecuteAsync()
    {
        _error = null;
        var response = await Http.PostAsync(
            $"api/v1/app-conversations/{ConversationId}/plan/execute", null);
        if (!response.IsSuccessStatusCode)
        {
            _error = await response.Content.ReadAsStringAsync();
        }
        await LoadAsync();
    }

    private async Task LoadDiffAsync(string file)
    {
        var response = await Http.GetAsync(
            $"api/v1/app-conversations/{ConversationId}/plan/diff?file={Uri.EscapeDataString(file)}");
        _diff = response.IsSuccessStatusCode
            ? await response.Content.ReadAsStringAsync()
            : null;
    }

    private static string Key(JsonElement item) =>
        item.GetProperty("id").GetGuid().ToString();

    private static string? Str(JsonElement item, string name) =>
        item.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString() : null;

    private static IEnumerable<string> Files(JsonElement item) =>
        item.TryGetProperty("files", out var files) && files.ValueKind == JsonValueKind.Array
            ? files.EnumerateArray().Select(x => x.GetString() ?? "") : [];

    private static IEnumerable<string> Comments(JsonElement item) =>
        item.TryGetProperty("comments", out var comments) && comments.ValueKind == JsonValueKind.Array
            ? comments.EnumerateArray().Select(x => x.GetString() ?? "") : [];
}

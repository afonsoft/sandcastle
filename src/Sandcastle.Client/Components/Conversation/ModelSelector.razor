@* SPEC-26 RF-003: seletor de modelo no topbar — catálogo /models,
   switch via POST /{id}/switch_acp_model (vale a partir do próximo run). *@
@using Sandcastle.Client.Services
@inject SandcastleApiClient Api
@inject ToastService Toasts
@inject LocalizationService L

<select class="model-sel" value="@Current" @onchange="OnChange"
        aria-label="@L["model.aria"]" title="@L["model.title"]">
    @if (_models.Count == 0)
    {
        <option value="@Current">@Current</option>
    }
    @* SPEC-157 RF-004: presets do workspace aplicam model(+provider). *@
    @if (_presets.Count > 0)
    {
        <optgroup label="@L["model.presets"]">
            @foreach (var pr in _presets)
            {
                <option value="@pr.Model">@pr.Name (@pr.Model)</option>
            }
        </optgroup>
    }
    @foreach (var m in _models)
    {
        <option value="@m">@m</option>
    }
    @if (Current is { } cur && !_models.Contains(cur))
    {
        <option value="@cur">@cur</option>
    }
</select>

@code {
    /// <summary>Modelo atual da conversa (pode ser nulo → default).</summary>
    [Parameter] public string? Current { get; set; }
    /// <summary>Dispara quando o usuário confirma a troca.</summary>
    [Parameter] public EventCallback<string> OnSwitch { get; set; }

    private List<string> _models = [];
    private List<Preset> _presets = [];

    private sealed record Preset(string Name, string Model);

    /// <summary>
    /// SPEC-157: preset aplica provider+model — provider é resolvido
    /// pelo gateway a partir do model id (agent_type vale na criação
    /// de novas conversas, não switchável em runtime).
    /// </summary>
    private async Task LoadPresetsAsync()
    {
        try
        {
            var items = await Api.ListWorkspaceItemsAsync("model_preset");
            _presets = items
                .Select(i => new Preset(
                    i.Name,
                    i.Body.TryGetProperty("model", out var m)
                        ? m.GetString() ?? "" : ""))
                .Where(p => p.Model.Length > 0)
                .ToList();
        }
        catch (Exception) { /* presets opcionais */ }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var (ids, def) = await Api.GetModelsAsync();
            _models = ids.Where(i => i.Length > 0).ToList();
            // SPEC-50 RF-003/RF-005: BYOR ativo → só os modelos que o
            // proxy permite (a enforcement real é no runner — fail-closed).
            var permitted = await Api.GetByorPermittedModelsAsync();
            if (permitted is { Count: > 0 })
            {
                _models = _models.Where(permitted.Contains).ToList();
            }

            if (Current is null && def is not null)
            {
                Current = def;
            }
            await LoadPresetsAsync();
        }
        catch (HttpRequestException) { /* descoberta degradada — só atual */ }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        var model = e.Value?.ToString();
        if (string.IsNullOrEmpty(model) || model == Current)
        {
            return;
        }

        Current = model;
        if (OnSwitch.HasDelegate)
        {
            await OnSwitch.InvokeAsync(model);
        }
    }
}

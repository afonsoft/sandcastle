@* SPEC-159: botão de ditado (STT) — esconde quando o navegador não
   suporta Web Speech; pulso durante listening; erros via OnError. *@
@using Sandcastle.Client.Services
@inject IJSRuntime JS
@inject LocalizationService L
@implements IAsyncDisposable

@if (_supported)
{
    <button class="icon-btn voice-btn @(_listening ? "listening" : "")"
            title="@(_listening ? L["composer.voice_stop"] : L["composer.voice_dictate"])"
            aria-label="@(_listening ? L["composer.voice_stop"] : L["composer.voice_dictate"])"
            aria-pressed="@_listening"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" width="16" height="16"
             aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 0 1 6 0v8.25a3 3 0 0 1-3 3Z" />
        </svg>
    </button>
    @if (_listening)
    {
        <span class="voice-live" role="status" aria-live="polite">
            @L["composer.voice_listening"]
        </span>
    }
}

@code {
    /// <summary>Texto acumulado (parcial+final) do ditado em andamento.</summary>
    [Parameter] public EventCallback<string> OnTranscript { get; set; }

    /// <summary>Ditado iniciou — o pai captura o texto base do input.</summary>
    [Parameter] public EventCallback OnDictationStarted { get; set; }

    /// <summary>Ditado terminou (fim da fala ou stop manual).</summary>
    [Parameter] public EventCallback OnDictationEnded { get; set; }

    /// <summary>Erro do STT: "not-allowed" | "no-speech" | "unsupported" | outro.</summary>
    [Parameter] public EventCallback<string> OnError { get; set; }

    /// <summary>Desabilita externamente (ex.: Sending).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Idioma do reconhecimento — default = idioma da UI.</summary>
    [Parameter] public string? Lang { get; set; }

    private string SttLang => Lang ?? L.Language;

    private bool _supported = true;
    private bool _listening;
    private DotNetObjectReference<VoiceButton>? _ref;

    /// <summary>Exposto para testes.</summary>
    public bool IsListening => _listening;
    public bool IsSupported => _supported;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }
        try
        {
            _supported = await JS.InvokeAsync<bool>("scSpeech.supported");
        }
        catch (Exception)
        {
            _supported = false; // JS indisponível (bUnit strict) → esconde.
        }

        if (!_supported)
        {
            StateHasChanged();
        }
    }

    private async Task ToggleAsync()
    {
        if (_listening)
        {
            await JS.InvokeVoidAsync("scSpeech.stop");
            return;
        }

        _ref ??= DotNetObjectReference.Create(this);
        var started = false;
        try
        {
            started = await JS.InvokeAsync<bool>(
                "scSpeech.start", _ref, SttLang);
        }
        catch (Exception)
        {
            started = false;
        }

        _listening = started;
        if (!started)
        {
            await OnError.InvokeAsync("unsupported");
        }
        else
        {
            await OnDictationStarted.InvokeAsync();
        }
    }

    /// <summary>Callback JS: texto acumulado do ditado.</summary>
    [JSInvokable]
    public Task OnSttResult(string text) => OnTranscript.InvokeAsync(text);

    /// <summary>Callback JS: ditado encerrado.</summary>
    [JSInvokable]
    public async Task OnSttEnded()
    {
        _listening = false;
        await OnDictationEnded.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Callback JS: erro do reconhecimento.</summary>
    [JSInvokable]
    public async Task OnSttError(string error)
    {
        _listening = false;
        await OnError.InvokeAsync(error);
        await InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_listening)
        {
            try { await JS.InvokeVoidAsync("scSpeech.stop"); }
            catch (Exception) { /* página já descarregando */ }
        }

        _ref?.Dispose();
    }
}

@inject HttpClient Http
@inject Sandcastle.Client.Services.LocalizationService L
@using System.Text.Json
@using System.Text.Json.Serialization

<p>@L["skills.subtitle"]</p>

@if (skills == null)
{
    <p><em>@L["common.loading"]</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["skills.name"]</th>
                <th>@L["customize.scope"]</th>
                <th>@L["skills.source"]</th>
                <th>@L["skills.description"]</th>
                <th>@L["skills.allowed_tools"]</th>
                <th>@L["skills.enabled"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in skills)
            {
                <tr>
                    <td><code>@s.Name</code></td>
                    <td><span class="badge">@ScopeLabel(s.Source)</span></td>
                    <td><span class="badge badge-dim">@SourceLabel(s.Source)</span></td>
                    <td>@s.Description</td>
                    <td>
                        <input type="text" list="skill-tool-names"
                               aria-label="@L["skills.allowed_tools"]"
                               placeholder="@L["skills.allowed_tools_placeholder"]"
                               value="@AllowedToolsText(s)"
                               disabled="@IsReadOnly(s)"
                               @onchange="e => SaveAllowedToolsAsync(s, e.Value?.ToString())" />
                    </td>
                    <td>
                        <input type="checkbox" checked="@s.Enabled"
                               aria-label="@L["skills.enabled"]"
                               disabled="@(s.Source == "builtin")"
                               @onchange="_ => ToggleAsync(s)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@L["skills.new"]</h2>
<div>
    <input aria-label="@L["skills.name_placeholder"]" placeholder="@L["skills.name_placeholder"]" @bind="newName" />
    <input aria-label="@L["skills.desc_placeholder"]" placeholder="@L["skills.desc_placeholder"]" @bind="newDescription" />
    <textarea aria-label="@L["skills.content_placeholder"]" placeholder="@L["skills.content_placeholder"]" @bind="newContent" rows="6"
              style="width:100%"></textarea>
    <input aria-label="@L["skills.allowed_tools"]" placeholder="@L["skills.allowed_tools_placeholder"]"
           list="skill-tool-names" @bind="newAllowedTools" />
    <datalist id="skill-tool-names">
        @foreach (var tool in toolNames)
        {
            <option value="@tool"></option>
        }
    </datalist>
    <button @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(newName)">
        @L["common.create"]
    </button>
    @if (error is not null)
    {
        <p class="text-danger">@error</p>
    }
</div>

@code {
    private List<SkillDto>? skills;
    private string? newName;
    private string? newDescription;
    private string? newContent;
    private string? newAllowedTools;
    private string? error;
    private string[] toolNames = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try
        {
            toolNames = await Http.GetFromJsonAsync<string[]>(
                "api/v1/skills/tool-catalog") ?? [];
        }
        catch (JsonException)
        {
            toolNames = [];
        }
    }

    private async Task LoadAsync() =>
        skills = await Http.GetFromJsonAsync<List<SkillDto>>("api/v1/skills");

    private async Task CreateAsync()
    {
        error = null;
        var resp = await Http.PostAsJsonAsync("api/v1/skills", new
        {
            name = newName,
            description = newDescription,
            content_md = newContent ?? "",
            allowed_tools = ParseTools(newAllowedTools),
            triggers = new[] { new { type = "always", value = (string?)null } },
        });
        if (!resp.IsSuccessStatusCode)
        {
            error = await resp.Content.ReadAsStringAsync();
            return;
        }

        newName = newDescription = newContent = newAllowedTools = null;
        await LoadAsync();
    }

    private async Task SaveAllowedToolsAsync(SkillDto skill, string? raw)
    {
        await Http.PatchAsJsonAsync($"api/v1/skills/{skill.Id}", new
        {
            allowed_tools = ParseTools(raw),
            replace_allowed_tools = true,
        });
        await LoadAsync();
    }

    private static string[]? ParseTools(string? raw) =>
        string.IsNullOrWhiteSpace(raw) ? null : raw.Split(',',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string AllowedToolsText(SkillDto skill) =>
        skill.AllowedTools is null ? "" : string.Join(", ", skill.AllowedTools);

    private static bool IsReadOnly(SkillDto skill) =>
        skill.Source is "builtin" or "repo" or "marketplace";

    private async Task ToggleAsync(SkillDto skill)
    {
        await Http.PatchAsJsonAsync($"api/v1/skills/{skill.Id}",
            new { enabled = !skill.Enabled });
        await LoadAsync();
    }

    private string ScopeLabel(string source) => source switch
    {
        "org" or "builtin" => L["customize.scope_org"],
        _ => L["customize.scope_personal"],
    };

    private string SourceLabel(string source) => source switch
    {
        "builtin" => L["customize.source_builtin"],
        "org" => L["customize.source_manual"],
        "user" => L["customize.source_manual"],
        "repo" => L["customize.source_repo"],
        "marketplace" => L["customize.source_marketplace"],
        _ => source,
    };

    private sealed record SkillDto(
        Guid Id, string Name, string? Description,
        string Source, bool Enabled,
        [property: JsonPropertyName("allowed_tools")]
        IReadOnlyList<string>? AllowedTools);
}

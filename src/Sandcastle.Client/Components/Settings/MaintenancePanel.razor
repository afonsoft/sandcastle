@using Sandcastle.Client.Services
@inject SandcastleApiClient Api
@inject ToastService Toasts
@inject LocalizationService L
@inject IJSRuntime JS

@* SPEC-158 RF-005: export de dados + limpeza de caches locais. *@
<h3>@L["settings.maintenance"]</h3>

<div class="settings-section">
    <h4>@L["settings.maintenance.export"]</h4>
    <a class="badge" href="@SandcastleApiClient.ExportUrl" download>
        @L["settings.maintenance.download_export"]
    </a>
</div>

<div class="settings-section">
    <h4>@L["settings.maintenance.clear_caches"]</h4>
    <p style="color:var(--sc-fg-dim)">@L["settings.maintenance.clear_hint"]</p>
    @if (_confirmClear)
    {
        <button type="button" class="badge" @onclick="ClearCachesAsync">
            @L["settings.maintenance.clear_confirm"]
        </button>
        <button type="button" class="badge badge-dim"
                @onclick="() => _confirmClear = false">
            @L["common.cancel"]
        </button>
    }
    else
    {
        <button type="button" class="badge badge-dim"
                @onclick="() => _confirmClear = true">
            @L["settings.maintenance.clear_button"]
        </button>
    }
</div>

@code {
    private bool _confirmClear;

    private async Task ClearCachesAsync()
    {
        // Caches locais: localStorage (preferências client-side) + caches
        // do service worker; sessão/servidor não são tocados.
        await JS.InvokeVoidAsync("localStorage.clear");
        try
        {
            await JS.InvokeVoidAsync(
                "caches.keys().then(ks=>Promise.all(ks.map(caches.delete)))");
        }
        catch (Exception) { }

        _confirmClear = false;
        Toasts.Success(L["settings.maintenance.cleared"]);
    }
}
